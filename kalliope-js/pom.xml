<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>hu.porkolab.kalliope</groupId>
    <artifactId>kalliope</artifactId>
    <version>2.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>kalliope-js</artifactId>
  <name>Kalliopé :: js</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <teavm.version>0.12.0</teavm.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>hu.porkolab.kalliope</groupId>
      <artifactId>kalliope-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      A classlib a TeaVM JCL-emulációja. Enélkül a fordító a futtató JDK saját
      osztályait próbálja olvasni, és a Java 25-ös bytecode-on elhasal.
    -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
      <version>${teavm.version}</version>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
      <version>${teavm.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <version>${teavm.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>compile</goal>
            </goals>
            <phase>process-classes</phase>
            <configuration>
              <mainClass>hu.porkolab.kalliope.js.KalliopeJs</mainClass>
              <targetType>JAVASCRIPT</targetType>
              <targetDirectory>${project.build.directory}/js</targetDirectory>
              <targetFileName>kalliope.js</targetFileName>
              <optimizationLevel>ADVANCED</optimizationLevel>
              <minifying>true</minifying>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
